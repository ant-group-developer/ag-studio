{
  "name": "@ag-studio/engine",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ag-farm/owner-client": "link:../../../ag-farm/packages/owner-client",
    "@ag-farm/protocol": "link:../../../ag-farm/packages/protocol",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@harness/adapter-agent-cli": "workspace:*",
    "@harness/contracts": "workspace:*",
    "@harness/core": "workspace:*",
    "@harness/executors": "workspace:*",
    "pg": "^8.23.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "vitest": "^2.1.0"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing.d.ts"
      ]
    }
  }
}
