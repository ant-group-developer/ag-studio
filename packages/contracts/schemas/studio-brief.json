{
  "$ref": "#/definitions/studio-brief",
  "definitions": {
    "studio-brief": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "studio.brief/v2"
        },
        "production_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_user_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "goal": {
          "type": "string",
          "maxLength": 1000
        },
        "audience": {
          "type": "string",
          "maxLength": 1000
        },
        "tone": {
          "type": "string",
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        },
        "folder_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 50
        },
        "episode_target_seconds": {
          "type": "number",
          "minimum": 10,
          "maximum": 3600
        },
        "max_episodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "aspect": {
          "type": "string",
          "enum": [
            "16:9",
            "9:16"
          ]
        },
        "canvas": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 160,
              "maximum": 7680
            },
            "height": {
              "type": "integer",
              "minimum": 160,
              "maximum": 7680
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "fps": {
          "type": "number",
          "enum": [
            25,
            30
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "music": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "track": {
                  "type": "string",
                  "pattern": "^library:[A-Za-z0-9._\\-/]+$"
                },
                "gain_db": {
                  "type": "number",
                  "minimum": -40,
                  "maximum": 0
                },
                "ducking": {
                  "type": "boolean"
                }
              },
              "required": [
                "track",
                "gain_db",
                "ducking"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "youtube_channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 20
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 20
        },
        "narration_voice": {
          "type": "string",
          "enum": [
            "ready",
            "missing",
            "none"
          ]
        }
      },
      "required": [
        "schema_version",
        "production_id",
        "run_id",
        "owner_user_id",
        "title",
        "description",
        "goal",
        "audience",
        "tone",
        "notes",
        "folder_ids",
        "episode_target_seconds",
        "max_episodes",
        "aspect",
        "canvas",
        "fps",
        "language",
        "music",
        "youtube_channels",
        "keywords"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
