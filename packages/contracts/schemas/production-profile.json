{
  "$ref": "#/definitions/production-profile",
  "definitions": {
    "production-profile": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.production-profile/v1"
        },
        "profile_id": {
          "type": "string",
          "enum": [
            "cartoon",
            "avatar",
            "footage",
            "studio",
            "channel",
            "channel-planning",
            "studio-production"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "draft",
            "retired"
          ]
        },
        "workflow_release": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*@\\d+\\.\\d+\\.\\d+$"
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {},
          "default": {}
        },
        "options_schema": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "default": {}
        },
        "options_defaults": {
          "type": "object",
          "additionalProperties": {},
          "default": {}
        },
        "reuse": {
          "type": "string",
          "enum": [
            "allow",
            "never"
          ],
          "default": "allow"
        },
        "content": {
          "type": "object",
          "properties": {
            "target_duration_seconds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "max_silence_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "verification": {
          "type": "object",
          "properties": {
            "required_checks": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "required_checks_by_stage": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {}
            }
          },
          "additionalProperties": false,
          "default": {
            "required_checks": [],
            "required_checks_by_stage": {}
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_cost_usd_per_variant": {
              "type": "number",
              "minimum": 0,
              "default": 5
            },
            "max_concurrency": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          "additionalProperties": false,
          "default": {
            "max_cost_usd_per_variant": 5,
            "max_concurrency": 1
          }
        }
      },
      "required": [
        "schema_version",
        "profile_id",
        "revision",
        "status",
        "workflow_release"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
