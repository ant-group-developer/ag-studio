{
  "$ref": "#/definitions/workflow",
  "definitions": {
    "workflow": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.workflow/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "defaults": {
          "type": "object",
          "additionalProperties": {},
          "default": {}
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "executor": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "script"
                      },
                      "script": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "script"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "agent"
                      },
                      "skill": {
                        "type": "string",
                        "minLength": 1
                      },
                      "brief": {
                        "type": "string",
                        "default": ""
                      }
                    },
                    "required": [
                      "type",
                      "skill"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "gate"
                      },
                      "brief": {
                        "type": "string",
                        "default": ""
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "depends_on_optional": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "when": {
                "type": "string",
                "pattern": "^options\\.([a-z][a-z0-9_]*) (==|!=) \"([^\"]*)\"$"
              },
              "requires_resources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "default": []
              },
              "gate_deadline_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "required_capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "required_checks": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "retry": {
                "type": "object",
                "properties": {
                  "max_attempts": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "backoff_seconds": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "retry_on": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "transient",
                        "result",
                        "contract",
                        "unknown",
                        "abandoned",
                        "deferred"
                      ]
                    }
                  }
                },
                "required": [
                  "max_attempts",
                  "backoff_seconds",
                  "retry_on"
                ],
                "additionalProperties": false,
                "default": {
                  "max_attempts": 3,
                  "backoff_seconds": [
                    10,
                    60,
                    300
                  ],
                  "retry_on": [
                    "transient",
                    "abandoned"
                  ]
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mime_type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "file",
                        "directory"
                      ],
                      "default": "file"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "mime_type"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "config": {
                "type": "object",
                "additionalProperties": {},
                "default": {}
              }
            },
            "required": [
              "key",
              "executor"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "id",
        "version",
        "stages"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
