{
  "$ref": "#/definitions/studio-youtube",
  "definitions": {
    "studio-youtube": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "studio.youtube/v1"
        },
        "production_id": {
          "type": "string",
          "minLength": 1
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "alt_titles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "start_s",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "playlist": {
          "type": "string"
        },
        "thumbnail_key": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "production_id",
        "episode_id",
        "title",
        "alt_titles",
        "description",
        "chapters",
        "tags",
        "hashtags",
        "playlist",
        "thumbnail_key"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
