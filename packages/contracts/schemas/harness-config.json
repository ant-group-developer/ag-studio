{
  "$ref": "#/definitions/harness-config",
  "definitions": {
    "harness-config": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.config/v1"
        },
        "lease_seconds": {
          "type": "integer",
          "minimum": 5,
          "default": 90
        },
        "heartbeat_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "poll_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "default_deadline_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 3600
        },
        "default_max_cost_usd": {
          "type": "number",
          "minimum": 0,
          "default": 5
        },
        "retention": {
          "type": "object",
          "properties": {
            "workspace_days": {
              "type": "integer",
              "minimum": 0,
              "default": 7
            }
          },
          "additionalProperties": false,
          "default": {
            "workspace_days": 7
          }
        },
        "allowed_override_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lease_seconds",
            "default_deadline_seconds",
            "default_max_cost_usd"
          ]
        },
        "resource_wait_warn_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 600
        }
      },
      "required": [
        "schema_version"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
