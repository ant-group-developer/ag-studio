{
  "$ref": "#/definitions/studio-narration",
  "definitions": {
    "studio-narration": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "studio.narration/v1"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "line_id": {
                "type": "string",
                "pattern": "^L\\d{3}$"
              },
              "beat_id": {
                "type": "string",
                "pattern": "^B\\d{2}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            },
            "required": [
              "line_id",
              "beat_id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 300
        }
      },
      "required": [
        "schema_version",
        "language",
        "lines"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
