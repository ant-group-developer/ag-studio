{
  "$ref": "#/definitions/studio-timeline-v3",
  "definitions": {
    "studio-timeline-v3": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "studio.timeline/v3"
        },
        "production_id": {
          "type": "string",
          "minLength": 1
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "canvas": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 160,
              "maximum": 7680
            },
            "height": {
              "type": "integer",
              "minimum": 160,
              "maximum": 7680
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "fps": {
          "type": "number",
          "enum": [
            25,
            30
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "clips": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clip_id": {
                "type": "string",
                "pattern": "^C\\d{3,4}$"
              },
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "section_title": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "clip_id",
              "asset_id",
              "section_title"
            ],
            "additionalProperties": false
          }
        },
        "texts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text_id": {
                "type": "string",
                "pattern": "^T\\d{3}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "title",
                  "callout",
                  "lower_third"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "duration": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 20
              },
              "position": {
                "type": "string",
                "enum": [
                  "top_left",
                  "top_center",
                  "top_right",
                  "center",
                  "bottom_left",
                  "bottom_center",
                  "bottom_right"
                ]
              }
            },
            "required": [
              "text_id",
              "kind",
              "text",
              "start",
              "duration",
              "position"
            ],
            "additionalProperties": false
          }
        },
        "music": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "track": {
                  "type": "string",
                  "pattern": "^library:[A-Za-z0-9._\\-/]+$"
                },
                "gain_db": {
                  "type": "number",
                  "minimum": -40,
                  "maximum": 0
                },
                "ducking": {
                  "type": "boolean"
                }
              },
              "required": [
                "track",
                "gain_db",
                "ducking"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "source_audio": {
          "type": "object",
          "properties": {
            "muted": {
              "type": "boolean"
            }
          },
          "required": [
            "muted"
          ],
          "additionalProperties": false
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "summary_vi": {
                "type": "string"
              },
              "duration_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "orientation": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "title",
              "summary_vi",
              "duration_s",
              "orientation"
            ],
            "additionalProperties": false
          }
        },
        "alternates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "asset_id",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "production_id",
        "episode_id",
        "canvas",
        "fps",
        "language",
        "clips",
        "texts",
        "music",
        "source_audio",
        "assets",
        "alternates"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
