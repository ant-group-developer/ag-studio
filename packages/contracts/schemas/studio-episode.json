{
  "$ref": "#/definitions/studio-episode",
  "definitions": {
    "studio-episode": {
      "type": "object",
      "properties": {
        "idx": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "hook": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "logline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "target_seconds": {
          "type": "number",
          "minimum": 10,
          "maximum": 3600
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "section_title": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "asset_id",
              "reason",
              "section_title"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 60
        },
        "alternates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "asset_id",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "texts_suggested": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "title",
                  "callout",
                  "lower_third"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "at_item": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "text",
              "at_item"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "edit_style": {
          "type": "string",
          "enum": [
            "whole",
            "cut"
          ]
        },
        "narration": {
          "type": "string",
          "enum": [
            "none",
            "tts",
            "original"
          ]
        },
        "schema_version": {
          "type": "string",
          "const": "studio.episode/v1"
        },
        "production_id": {
          "type": "string",
          "minLength": 1
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "summary_vi": {
                "type": "string"
              },
              "duration_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "orientation": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "title",
              "summary_vi",
              "duration_s",
              "orientation"
            ],
            "additionalProperties": false
          }
        },
        "asset_hints": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "subjects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "places": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mood": {
                "type": "string"
              },
              "setting": {
                "type": "string"
              },
              "time_of_day": {
                "type": "string"
              },
              "people_count": {
                "type": "string"
              },
              "shot_variety": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "has_speech": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "subjects",
              "places",
              "mood",
              "setting",
              "time_of_day",
              "people_count",
              "shot_variety",
              "has_speech"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "idx",
        "title",
        "hook",
        "logline",
        "target_seconds",
        "items",
        "alternates",
        "texts_suggested",
        "schema_version",
        "production_id",
        "episode_id",
        "assets"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
