{
  "$ref": "#/definitions/shots",
  "definitions": {
    "shots": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.shots/v2"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^src_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "file_name": {
                "type": "string"
              },
              "duration_seconds": {
                "type": "number",
                "minimum": 0
              },
              "has_audio": {
                "type": "boolean"
              },
              "error": {
                "type": "string"
              },
              "shots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "shot_id": {
                      "type": "string",
                      "pattern": "^s\\d{3}-\\d{3}$"
                    },
                    "in": {
                      "type": "number",
                      "minimum": 0
                    },
                    "out": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "shot_id",
                    "in",
                    "out"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "source_id",
              "index",
              "file_name",
              "duration_seconds",
              "has_audio",
              "shots"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "sources"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
