{
  "$ref": "#/definitions/studio-edit-plan",
  "definitions": {
    "studio-edit-plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "studio.edit-plan/v1"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "narration": {
          "type": "string",
          "enum": [
            "none",
            "tts",
            "original"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "target_seconds": {
          "type": "number",
          "minimum": 10,
          "maximum": 3600
        },
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "shot_id": {
                "type": "string",
                "pattern": "^s\\d{3}-\\d{3}$"
              },
              "source_id": {
                "type": "string",
                "pattern": "^src_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "in": {
                "type": "number",
                "minimum": 0
              },
              "out": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "line_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^L\\d{3}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "transition": {
                "type": "string",
                "enum": [
                  "cut",
                  "dissolve",
                  "dip_black"
                ]
              },
              "transition_s": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 1
              },
              "section_title": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 300
              },
              "source_audio": {
                "type": "string",
                "enum": [
                  "keep",
                  "mute"
                ]
              },
              "gain_db": {
                "type": "number",
                "minimum": -30,
                "maximum": 20
              },
              "snap": {
                "type": "string",
                "enum": [
                  "beat",
                  "bar"
                ]
              }
            },
            "required": [
              "order",
              "shot_id",
              "source_id",
              "in",
              "out",
              "line_id",
              "transition",
              "section_title",
              "note"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 400
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "line_id": {
                "type": "string",
                "pattern": "^L\\d{3}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            },
            "required": [
              "line_id",
              "text"
            ],
            "additionalProperties": false
          },
          "maxItems": 300
        },
        "texts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text_id": {
                "type": "string",
                "pattern": "^T\\d{3}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "title",
                  "callout",
                  "lower_third"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "at_order": {
                "type": "integer",
                "minimum": 1
              },
              "offset_s": {
                "type": "number",
                "minimum": 0
              },
              "duration": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 600
              },
              "position": {
                "type": "string",
                "enum": [
                  "top_left",
                  "top_center",
                  "top_right",
                  "center",
                  "bottom_left",
                  "bottom_center",
                  "bottom_right"
                ]
              },
              "size": {
                "type": "string",
                "enum": [
                  "s",
                  "m",
                  "l"
                ]
              }
            },
            "required": [
              "text_id",
              "kind",
              "text",
              "at_order",
              "offset_s",
              "duration",
              "position"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        },
        "music_mood": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "music_envelope": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at_order": {
                "type": "integer",
                "minimum": 1
              },
              "offset_s": {
                "type": "number",
                "minimum": 0
              },
              "gain_db": {
                "type": "number",
                "minimum": -60,
                "maximum": 0
              }
            },
            "required": [
              "at_order",
              "offset_s",
              "gain_db"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 200
        },
        "source_even": {
          "type": "boolean"
        },
        "music": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "gain_db": {
                  "type": "number",
                  "minimum": -40,
                  "maximum": 0
                },
                "ducking": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "source_muted": {
          "type": "boolean"
        },
        "text_look": {
          "type": "object",
          "properties": {
            "text_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "outline_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "box_color": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "size": {
              "type": "string",
              "enum": [
                "s",
                "m",
                "l"
              ]
            },
            "shadow": {
              "type": "boolean"
            },
            "font": {
              "type": "string",
              "enum": [
                "Arial",
                "Be Vietnam Pro",
                "Noto Sans JP",
                "Noto Sans KR",
                "Noto Serif",
                "Playfair Display",
                "Montserrat",
                "Oswald",
                "Bebas Neue",
                "Anton",
                "Inter",
                "Roboto",
                "Poppins",
                "Lato",
                "Raleway",
                "Josefin Sans",
                "Quicksand",
                "Cormorant Garamond",
                "DM Serif Display",
                "Libre Baskerville",
                "Cinzel",
                "Great Vibes",
                "Pacifico",
                "Caveat",
                "Noto Serif JP",
                "M PLUS Rounded 1c",
                "Zen Maru Gothic",
                "Zen Kaku Gothic New",
                "Shippori Mincho",
                "Dela Gothic One",
                "Kiwi Maru",
                "Klee One",
                "RocknRoll One",
                "BIZ UDPGothic",
                "Noto Serif KR",
                "Nanum Gothic",
                "Nanum Myeongjo",
                "Nanum Pen Script",
                "Black Han Sans",
                "Do Hyeon",
                "Jua",
                "Gowun Dodum",
                "Gowun Batang",
                "IBM Plex Sans KR"
              ]
            }
          },
          "required": [
            "text_color",
            "outline_color",
            "box_color",
            "size"
          ],
          "additionalProperties": false
        },
        "look": {
          "type": "string",
          "enum": [
            "none",
            "natural",
            "vivid",
            "warm",
            "cinematic"
          ]
        }
      },
      "required": [
        "schema_version",
        "episode_id",
        "narration",
        "language",
        "target_seconds",
        "shots",
        "lines",
        "texts",
        "music_mood"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
