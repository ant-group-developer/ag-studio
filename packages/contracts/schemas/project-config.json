{
  "$ref": "#/definitions/project-config",
  "definitions": {
    "project-config": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.project/v1"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "template_release": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ]
        },
        "data_root": {
          "type": "string",
          "minLength": 1
        },
        "portfolios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "portfolio_id": {
                "type": "string",
                "minLength": 1
              },
              "display_name": {
                "type": "string"
              }
            },
            "required": [
              "portfolio_id",
              "display_name"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "template_release",
        "runtime",
        "data_root",
        "portfolios"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
