{
  "$ref": "#/definitions/project-config",
  "definitions": {
    "project-config": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.project-config/v1"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "template_release": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ]
        },
        "data_root": {
          "type": "string",
          "minLength": 1
        },
        "portfolios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "portfolio_id": {
                "type": "string",
                "minLength": 1
              },
              "display_name": {
                "type": "string"
              }
            },
            "required": [
              "portfolio_id",
              "display_name"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "default": {}
        },
        "source": {
          "type": "object",
          "properties": {
            "materialize": {
              "type": "string",
              "enum": [
                "link",
                "copy",
                "reference"
              ],
              "default": "link"
            }
          },
          "additionalProperties": false,
          "default": {
            "materialize": "link"
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*@\\d+\\.\\d+\\.\\d+$"
          }
        },
        "library": {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "enum": [
                "studio",
                "channel"
              ]
            },
            "sync_seconds": {
              "type": "integer",
              "minimum": 10,
              "default": 300
            }
          },
          "required": [
            "root",
            "role"
          ],
          "additionalProperties": false
        },
        "adapters": {
          "type": "object",
          "properties": {
            "publisher": {
              "type": "string",
              "enum": [
                "playwright",
                "fake"
              ],
              "default": "fake"
            },
            "agent": {
              "type": "string",
              "enum": [
                "cli",
                "fake"
              ],
              "default": "fake"
            },
            "agent_argv": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false,
          "default": {
            "publisher": "fake",
            "agent": "fake"
          }
        },
        "publication": {
          "type": "object",
          "properties": {
            "verify_seconds": {
              "type": "integer",
              "minimum": 60,
              "default": 900
            },
            "verify_grace_hours": {
              "type": "number",
              "minimum": 0,
              "default": 2
            }
          },
          "additionalProperties": false,
          "default": {
            "verify_seconds": 900,
            "verify_grace_hours": 2
          }
        },
        "dashboard": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 5200
            },
            "refresh_seconds": {
              "type": "integer",
              "minimum": 10,
              "default": 60
            }
          },
          "additionalProperties": false,
          "default": {
            "port": 5200,
            "refresh_seconds": 60
          }
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "template_release",
        "runtime",
        "data_root",
        "portfolios"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
