{
  "$ref": "#/definitions/project-config",
  "definitions": {
    "project-config": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.project-config/v1"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "template_release": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ]
        },
        "data_root": {
          "type": "string",
          "minLength": 1
        },
        "portfolios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "portfolio_id": {
                "type": "string",
                "minLength": 1
              },
              "display_name": {
                "type": "string"
              }
            },
            "required": [
              "portfolio_id",
              "display_name"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "default": {}
        },
        "source": {
          "type": "object",
          "properties": {
            "materialize": {
              "type": "string",
              "enum": [
                "link",
                "copy",
                "reference"
              ],
              "default": "link"
            }
          },
          "additionalProperties": false,
          "default": {
            "materialize": "link"
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*@\\d+\\.\\d+\\.\\d+$"
          }
        },
        "library": {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "enum": [
                "studio",
                "channel"
              ]
            },
            "sync_seconds": {
              "type": "integer",
              "minimum": 10,
              "default": 300
            },
            "auto_accept": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "source_collection": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "default": "main"
                },
                "source_collections": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9*-]*$"
                  }
                },
                "max_replans": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 2
                },
                "max_concurrent_runs": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                },
                "max_sources": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 40
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "root",
            "role"
          ],
          "additionalProperties": false
        },
        "adapters": {
          "type": "object",
          "properties": {
            "publisher": {
              "type": "string",
              "enum": [
                "playwright",
                "fake"
              ],
              "default": "fake"
            },
            "agent": {
              "type": "string",
              "enum": [
                "cli",
                "fake"
              ],
              "default": "fake"
            },
            "agent_argv": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "stats": {
              "type": "string",
              "enum": [
                "playwright",
                "fake"
              ],
              "default": "fake"
            },
            "media": {
              "type": "string",
              "enum": [
                "python",
                "fake"
              ],
              "default": "fake"
            }
          },
          "additionalProperties": false,
          "default": {
            "publisher": "fake",
            "agent": "fake",
            "stats": "fake",
            "media": "fake"
          }
        },
        "publication": {
          "type": "object",
          "properties": {
            "verify_seconds": {
              "type": "integer",
              "minimum": 60,
              "default": 900
            },
            "verify_grace_hours": {
              "type": "number",
              "minimum": 0,
              "default": 2
            }
          },
          "additionalProperties": false,
          "default": {
            "verify_seconds": 900,
            "verify_grace_hours": 2
          }
        },
        "dashboard": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 5200
            },
            "refresh_seconds": {
              "type": "integer",
              "minimum": 10,
              "default": 60
            }
          },
          "additionalProperties": false,
          "default": {
            "port": 5200,
            "refresh_seconds": 60
          }
        },
        "learning": {
          "type": "object",
          "properties": {
            "collect_seconds": {
              "type": "integer",
              "minimum": 60,
              "default": 1800
            },
            "collect_batch": {
              "type": "integer",
              "minimum": 1,
              "default": 5
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "media": {
          "type": "object",
          "properties": {
            "python": {
              "type": "string",
              "minLength": 1
            },
            "device": {
              "type": "string",
              "pattern": "^(cuda:\\d+|cpu)$",
              "default": "cuda:0"
            },
            "transcribe": {
              "type": "object",
              "properties": {
                "engine": {
                  "type": "string",
                  "const": "whisperx",
                  "default": "whisperx"
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "default": "large-v3"
                },
                "compute_type": {
                  "type": "string",
                  "minLength": 1,
                  "default": "float16"
                },
                "batch_size": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 8
                },
                "python": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "default": {}
            },
            "tts": {
              "type": "object",
              "properties": {
                "engine": {
                  "type": "string",
                  "const": "omnivoice",
                  "default": "omnivoice"
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "default": "k2-fsa/OmniVoice"
                },
                "dtype": {
                  "type": "string",
                  "minLength": 1,
                  "default": "float16"
                },
                "num_step": {
                  "type": "integer",
                  "minimum": 4,
                  "maximum": 128,
                  "default": 32
                },
                "max_chars": {
                  "type": "integer",
                  "minimum": 80,
                  "maximum": 600,
                  "default": 280
                },
                "pause_seconds": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0.25
                },
                "loudness_lufs": {
                  "type": "number",
                  "default": -16
                },
                "python": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "default": {}
            },
            "scene": {
              "type": "object",
              "properties": {
                "threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.3
                },
                "min_shot_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 1
                },
                "max_shot_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 20
                },
                "proxy_height": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 540
                }
              },
              "additionalProperties": false,
              "default": {}
            },
            "watch": {
              "type": "object",
              "properties": {
                "max_sheets": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 24
                }
              },
              "additionalProperties": false,
              "default": {}
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "template_release",
        "runtime",
        "data_root",
        "portfolios"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
