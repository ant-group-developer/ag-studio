{
  "$ref": "#/definitions/requests-receipt",
  "definitions": {
    "requests-receipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.requests-receipt/v1"
        },
        "request_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "downgraded_voice": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        }
      },
      "required": [
        "schema_version",
        "request_ids"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
