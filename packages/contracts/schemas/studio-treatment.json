{
  "$ref": "#/definitions/studio-treatment",
  "definitions": {
    "studio-treatment": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "studio.treatment/v1"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "logline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "beat_id": {
                "type": "string",
                "pattern": "^B\\d{2}$"
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "seconds": {
                "type": "number",
                "minimum": 2,
                "maximum": 600
              },
              "visual_idea": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "narration_idea": {
                "type": "string",
                "maxLength": 1200
              }
            },
            "required": [
              "beat_id",
              "purpose",
              "seconds",
              "visual_idea",
              "narration_idea"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 40
        }
      },
      "required": [
        "schema_version",
        "title",
        "logline",
        "beats"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
