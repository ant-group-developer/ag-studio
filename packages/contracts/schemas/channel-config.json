{
  "$ref": "#/definitions/channel-config",
  "definitions": {
    "channel-config": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.channel-config/v1"
        },
        "channel_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "portfolio_id": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#5b8cff"
        },
        "repo_dir": {
          "type": "string",
          "minLength": 1
        },
        "legacy_project_id": {
          "type": "string",
          "minLength": 1,
          "default": "project-01"
        },
        "youtube": {
          "type": "object",
          "properties": {
            "expected_channel_id": {
              "type": "string",
              "minLength": 1
            },
            "account_email_ref": {
              "type": "string",
              "pattern": "^secret:\\/\\/[a-z0-9-]+\\/[a-z0-9-]+$"
            }
          },
          "required": [
            "expected_channel_id",
            "account_email_ref"
          ],
          "additionalProperties": false
        },
        "publication": {
          "type": "object",
          "properties": {
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "publish_times": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "minItems": 1
            },
            "max_daily_uploads": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "min_gap_hours": {
              "type": "number",
              "minimum": 0,
              "default": 20
            },
            "visibility_default": {
              "type": "string",
              "const": "private",
              "default": "private"
            }
          },
          "required": [
            "timezone",
            "publish_times"
          ],
          "additionalProperties": false
        },
        "seo": {
          "type": "object",
          "properties": {
            "niche": {
              "type": "string",
              "default": ""
            },
            "audience": {
              "type": "string",
              "default": ""
            },
            "angle": {
              "type": "string",
              "default": ""
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "default": "en"
            },
            "market": {
              "type": "string",
              "default": ""
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "title_rules": {
              "type": "string",
              "default": ""
            },
            "description_template": {
              "type": "string",
              "default": ""
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "episode": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "dir_pattern": {
              "type": "string",
              "pattern": "\\{nn\\}",
              "default": "episode-{nn}"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "overlay": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "side": {
              "type": "string",
              "enum": [
                "left",
                "right"
              ],
              "default": "right"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "learning": {
          "type": "object",
          "properties": {
            "horizon_hours": {
              "type": "integer",
              "minimum": 1,
              "default": 72
            },
            "recollect_hours": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "default": [
                168,
                720
              ]
            },
            "min_impressions": {
              "type": "integer",
              "minimum": 0,
              "default": 50
            },
            "min_samples": {
              "type": "integer",
              "minimum": 1,
              "default": 2
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "planning": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "lookahead_slots": {
              "type": "integer",
              "minimum": 1,
              "default": 3
            },
            "topics_per_run": {
              "type": "integer",
              "minimum": 1,
              "default": 3
            },
            "max_open_requests": {
              "type": "integer",
              "minimum": 1,
              "default": 3
            },
            "check_seconds": {
              "type": "integer",
              "minimum": 60,
              "default": 3600
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "auto_pick": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "max_concurrent_runs": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "required": [
        "schema_version",
        "channel_id",
        "display_name",
        "portfolio_id",
        "repo_dir",
        "youtube",
        "publication"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
