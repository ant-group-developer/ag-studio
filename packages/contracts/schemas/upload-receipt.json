{
  "$ref": "#/definitions/upload-receipt",
  "definitions": {
    "upload-receipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.upload-receipt/v1"
        },
        "publication_job_id": {
          "type": "string",
          "pattern": "^pub_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "video_id": {
          "type": "string",
          "minLength": 1
        },
        "operation_id": {
          "type": "string",
          "pattern": "^op_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "state": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "publication_job_id",
        "video_id",
        "operation_id",
        "state"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
