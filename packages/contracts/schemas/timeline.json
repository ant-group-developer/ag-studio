{
  "$ref": "#/definitions/timeline",
  "definitions": {
    "timeline": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.timeline/v1"
        },
        "voice": {
          "type": "string",
          "enum": [
            "none",
            "tts",
            "original"
          ]
        },
        "language": {
          "type": "string"
        },
        "total_seconds": {
          "type": "number",
          "minimum": 0
        },
        "video": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 0
              },
              "source_id": {
                "type": "string",
                "pattern": "^src_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "in": {
                "type": "number"
              },
              "out": {
                "type": "number"
              },
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              }
            },
            "required": [
              "order",
              "source_id",
              "in",
              "out",
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "narration": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "line_id": {
                "type": "string"
              },
              "wav": {
                "type": "string"
              },
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              },
              "words": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "word": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end": {
                      "type": "number",
                      "minimum": 0
                    },
                    "score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "word",
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "line_id",
              "wav",
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "speech": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^src_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              },
              "text": {
                "type": "string"
              },
              "words": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "word": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end": {
                      "type": "number",
                      "minimum": 0
                    },
                    "score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "word",
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "source_id",
              "start",
              "end",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "voice",
        "language",
        "total_seconds",
        "video",
        "narration",
        "speech"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
