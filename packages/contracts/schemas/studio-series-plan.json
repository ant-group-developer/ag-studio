{
  "$ref": "#/definitions/studio-series-plan",
  "definitions": {
    "studio-series-plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "studio.series-plan/v1"
        },
        "series_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "episodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "idx": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "hook": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "logline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "target_seconds": {
                "type": "number",
                "minimum": 10,
                "maximum": 3600
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "asset_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "section_title": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "asset_id",
                    "reason",
                    "section_title"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 60
              },
              "alternates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "asset_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "asset_id",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 10
              },
              "texts_suggested": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "title",
                        "callout",
                        "lower_third"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "at_item": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "kind",
                    "text",
                    "at_item"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 10
              }
            },
            "required": [
              "idx",
              "title",
              "hook",
              "logline",
              "target_seconds",
              "items",
              "alternates",
              "texts_suggested"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 30
        }
      },
      "required": [
        "schema_version",
        "series_title",
        "rationale",
        "episodes"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
