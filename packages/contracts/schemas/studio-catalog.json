{
  "$ref": "#/definitions/studio-catalog",
  "definitions": {
    "studio-catalog": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "studio.catalog/v2"
        },
        "production_id": {
          "type": "string",
          "minLength": 1
        },
        "folder_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "total_available": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "title_vi": {
                "type": "string"
              },
              "summary_vi": {
                "type": "string"
              },
              "duration_s": {
                "type": "number",
                "minimum": 0
              },
              "orientation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "genre": {
                "type": "string"
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subjects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "places": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keywords_vi": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mood": {
                "type": "string"
              },
              "setting": {
                "type": "string"
              },
              "time_of_day": {
                "type": "string"
              },
              "people_count": {
                "type": "string"
              },
              "shot_variety": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "has_speech": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "quality": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "usable": {
                "type": "boolean"
              },
              "approved": {
                "type": "boolean"
              },
              "project_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "asset_id",
              "name",
              "title_vi",
              "summary_vi",
              "duration_s",
              "orientation",
              "genre",
              "topics",
              "subjects",
              "places",
              "actions",
              "keywords_vi",
              "tags",
              "mood",
              "setting",
              "time_of_day",
              "people_count",
              "shot_variety",
              "has_speech",
              "quality",
              "usable",
              "approved",
              "project_names"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "production_id",
        "folder_ids",
        "total_available",
        "truncated",
        "assets"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
