{
  "$ref": "#/definitions/sources",
  "definitions": {
    "sources": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.sources/v1"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "collection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "default": "main"
              },
              "rights_status": {
                "type": "string",
                "enum": [
                  "unknown",
                  "cleared",
                  "restricted"
                ],
                "default": "unknown"
              },
              "language": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "schema_version"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
