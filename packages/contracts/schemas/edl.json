{
  "$ref": "#/definitions/edl",
  "definitions": {
    "edl": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.edl/v1"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^src_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "in": {
                "type": "number",
                "minimum": 0
              },
              "out": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "order": {
                "type": "integer",
                "minimum": 0
              },
              "overlay": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "avatar"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "note": {
                "type": "string",
                "default": ""
              }
            },
            "required": [
              "source_id",
              "in",
              "out",
              "order"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "entries"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
