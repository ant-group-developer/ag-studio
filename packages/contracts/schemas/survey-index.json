{
  "$ref": "#/definitions/survey-index",
  "definitions": {
    "survey-index": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.survey-index/v1"
        },
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "in": {
                "type": "number",
                "minimum": 0
              },
              "out": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "usable": {
                "type": "boolean"
              },
              "note": {
                "type": "string",
                "default": ""
              }
            },
            "required": [
              "in",
              "out",
              "score",
              "usable"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "shots"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
