{
  "$ref": "#/definitions/topic-proposal",
  "definitions": {
    "topic-proposal": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "harness.topic-proposal/v1"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 8
              },
              "angle": {
                "type": "string",
                "default": ""
              },
              "why": {
                "type": "string",
                "minLength": 1
              },
              "style_id": {
                "type": "string",
                "pattern": "^style_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "voice": {
                "type": "string",
                "enum": [
                  "none",
                  "tts",
                  "original"
                ]
              },
              "target_duration_seconds": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "number",
                    "minimum": 0
                  }
                ]
              },
              "source_hint": {
                "type": "object",
                "properties": {
                  "collection": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "topic",
              "why"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10
        }
      },
      "required": [
        "schema_version",
        "topics"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
