{
  "name": "youtube-operations-harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "gen:schemas": "pnpm --filter @harness/contracts run gen:schemas",
    "harness": "tsx packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@harness/contracts": "workspace:*",
    "@harness/core": "workspace:*",
    "@harness/executors": "workspace:*",
    "@harness/adapter-fake": "workspace:*",
    "@harness/worker": "workspace:*",
    "@harness/script-sdk": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.6.0"
  }
}
