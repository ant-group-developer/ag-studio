{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@studio/timeline": [
        "../../packages/core/src/studio/layout.ts"
      ],
      "@harness/contracts": [
        "../../packages/contracts/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
