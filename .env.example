# .env cho docker compose của AG Studio trên node trung tâm (api + worker đọc, web đọc lúc build).
# Sao chép thành .env rồi điền. Không commit .env.

# ---- Cổng trên VPS: web (nginx) phục vụ cả /api. Reverse proxy của VPS trỏ domain Studio vào đây ----
STUDIO_PORT=3100
# Checkout ag-farm nằm cạnh ag-studio (image build @ag-farm/* từ đó)
AG_FARM_DIR=../ag-farm

# ---- Auth0: cùng tenant và audience với ag-go ----
AUTH0_ISSUER_URL=https://your-tenant.auth0.com/
AUTH0_AUDIENCE=https://your-api-audience
AUTH0_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json
# client id của app Auth0 ag-studio-web
AUTH0_ALLOWED_CLIENT_IDS=your_studio_web_client_id

# ---- Account API ----
ACCOUNT_API_URL=https://account-api.example.com
ACCOUNT_API_KEY=

# ---- ag-go-api: khoá dịch vụ của Studio (bản rõ; ag-go-api giữ hash trong SERVICE_KEYS) ----
AG_GO_API_URL=https://go-api.example.com/api
AG_GO_SERVICE_KEY=CHANGE_ME

# ---- ag-farm ----
FARM_URL=https://farm-api.example.com
# Khoá owner "studio": in ra một lần bởi script create-owner-key của ag-farm
FARM_OWNER_KEY=CHANGE_ME
# Khoá công khai ký vé của ag-farm (dạng một dòng với \n)
FARM_TICKET_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
FARM_URL_TTL_SECONDS=3600

# ---- Bucket R2 riêng của Studio ----
STUDIO_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STUDIO_R2_BUCKET=ag-studio-dev
STUDIO_R2_ACCESS_KEY_ID=CHANGE_ME
STUDIO_R2_SECRET_ACCESS_KEY=CHANGE_ME
STUDIO_BROWSER_URL_TTL_SECONDS=3600

# ---- Claude (gói subscription): tạo bằng `claude setup-token` ----
CLAUDE_CODE_OAUTH_TOKEN=CHANGE_ME
# STUDIO_CLAUDE_MODEL=claude-opus-5-5
FARM_POLL_MS=5000

# ---- Web (nhúng lúc build) ----
VITE_AG_GO_API_URL=https://go-api.example.com/api
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_studio_web_client_id
VITE_AUTH0_AUDIENCE=https://your-api-audience
