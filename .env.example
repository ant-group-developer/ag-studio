# .env cho docker compose của AG Studio trên node trung tâm (api + worker đọc, web đọc lúc build).
# Sao chép thành .env rồi điền. Không commit .env.

# ---- Cổng trên VPS: web (nginx) phục vụ cả /api. Reverse proxy của VPS trỏ domain Studio vào đây ----
STUDIO_PORT=3100
# Checkout ag-farm nằm cạnh ag-studio (image build @ag-farm/* từ đó)
AG_FARM_DIR=../ag-farm
# Dữ liệu file của Studio (/data: workspace, transcript agent, giọng đọc) trên thư mục của VPS thay vì named volume, để xem bằng
# file manager. Đường dẫn tuyệt đối, ngoài checkout git. Copy dữ liệu từ volume cũ sang trước rồi mới đặt biến này.
# STUDIO_DATA_VOLUME=/www/code/ag-harness-agent/ag-studio-data

# ---- Postgres của Studio (server có sẵn trên VPS, không nằm trong docker compose) ----
# Từ container tới Postgres trên host: host.docker.internal. api và worker dùng chung database này.
DATABASE_URL=postgresql://ag_studio:CHANGE_ME@host.docker.internal:5432/ag_studio
# Schema chứa bảng của Studio (mặc định public); api tự tạo khi khởi động nếu chưa có. Chữ thường, số, _
# DATABASE_SCHEMA=studio
# Số kết nối tối đa mỗi tiến trình (api, worker) mở; mặc định 10
# STUDIO_DB_POOL_MAX=10

# ---- Auth0: cùng tenant và audience với ag-go ----
AUTH0_ISSUER_URL=https://your-tenant.auth0.com/
AUTH0_AUDIENCE=https://your-api-audience
AUTH0_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json
# client id của app Auth0 ag-studio-web
AUTH0_ALLOWED_CLIENT_IDS=your_studio_web_client_id

# ---- Account API ----
ACCOUNT_API_URL=https://account-api.example.com
ACCOUNT_API_KEY=
# Ứng dụng trong Account API có ADMIN và quyền (tải bản gốc…) mà Studio dùng: người dùng Studio là người dùng ag-go
# ACCOUNT_APPLICATION_CODE=ant-go-v2

# ---- ag-go-api: khoá dịch vụ của Studio (bản rõ; ag-go-api giữ hash trong SERVICE_KEYS) ----
# Scope cần có: footage:read (hỏi người bấm có thêm được project ag-go không), footage:studio (chế độ tin cậy: tìm, chuẩn bị,
# render footage của các project ag-go đã thêm vào dự án, không kiểm quyền người), usage:write (worker gửi thống kê dùng
# footage; thiếu thì ag-go trả 403, sự kiện nằm lại trong hộp thư đi và gửi lại sau).
AG_GO_API_URL=https://go-api.example.com/api
AG_GO_SERVICE_KEY=CHANGE_ME

# ---- ag-farm ----
FARM_URL=https://farm-api.example.com
# Khoá owner "studio": in ra một lần bởi script create-owner-key của ag-farm
FARM_OWNER_KEY=CHANGE_ME
# Khoá công khai ký vé của ag-farm (dạng một dòng với \n)
FARM_TICKET_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
FARM_URL_TTL_SECONDS=3600

# ---- Bucket R2 riêng của Studio ----
STUDIO_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STUDIO_R2_BUCKET=ag-studio-dev
STUDIO_R2_ACCESS_KEY_ID=CHANGE_ME
STUDIO_R2_SECRET_ACCESS_KEY=CHANGE_ME
STUDIO_BROWSER_URL_TTL_SECONDS=3600
# Trình duyệt tải file thẳng lên bucket này: bật CORS cho origin của web (GET, PUT; header Content-Type).
# Xem docs/runbooks/studio-local.md mục 4.

# ---- Claude (gói subscription): tạo bằng `claude setup-token` ----
CLAUDE_CODE_OAUTH_TOKEN=CHANGE_ME
# Số lượt Claude chạy cùng lúc trên mọi worker (1-100, mặc định 20). Nhiều hơn thì hạn mức gói hết nhanh hơn và tốn
# RAM (mỗi lượt một tiến trình `claude`); hết hạn mức thì các lượt tự chờ rồi chạy lại. Admin Studio sửa được ở màn
# Hàng đợi; số lưu trên web thắng biến này.
# STUDIO_CLAUDE_MAX_CONCURRENT=20

# ---- Agent làm việc trong dự án (spec 2026-10-10 agent-workspace) ----
# Ký token của mỗi lượt agent để server MCP gọi /api/agent-tools; api và worker phải cùng giá trị (`openssl rand -hex 32`).
# Không đặt: chat với agent trong dự án không chạy.
STUDIO_AGENT_TOKEN_SECRET=CHANGE_ME
# Nơi server MCP của lượt gọi API (từ máy worker; Docker: http://api:3100).
STUDIO_API_INTERNAL_URL=http://api:3100
# Thư mục dự án (mặc định <STUDIO_DATA_ROOT>/workspaces): api và worker phải thấy cùng thư mục; phải nằm ngoài mọi repo.
# STUDIO_WORKSPACES_ROOT=
# Thư mục cấu hình/session của CLI cho agent (mặc định <STUDIO_DATA_ROOT>/agent-claude): giữ qua mỗi lần deploy.
# STUDIO_AGENT_CLAUDE_CONFIG_DIR=
# Model của agent (mặc định sonnet; cài đặt của dự án thắng), số bước tối đa một lượt; một lượt dừng khi CLI im lặng quá
# STUDIO_AGENT_IDLE_MINUTES phút (0 = tắt) hoặc chạm trần cứng STUDIO_AGENT_TURN_MINUTES phút dù vẫn đang làm.
# STUDIO_AGENT_MODEL=sonnet
# STUDIO_AGENT_MAX_TURNS=40
# STUDIO_AGENT_IDLE_MINUTES=10
# STUDIO_AGENT_TURN_MINUTES=60
# Việc nền của dự án chạy cùng lúc trên worker (chờ ag-go chuẩn bị video, chờ farm dựng/render).
# STUDIO_JOB_LANES=2
# Mỗi máy farm đang rảnh (online, không chạy việc nào) cho thêm một việc cùng lúc, tối đa chừng này (≤ STUDIO_JOB_LANES:
# giữ cố định).
# STUDIO_JOB_LANES_MAX=8
# Việc chuẩn bị video (hỏi ag-go, tải khung hình) chạy cùng lúc tối đa chừng này, trong số việc trên (nhiều hơn thì ag-go trả 503).
# STUDIO_PREPARE_LANES=3
# Nhật ký hoạt động (thao tác ghi, tool của agent, lượt chat, việc nền) giữ bao nhiêu ngày trước khi quét dọn xoá.
# STUDIO_RETENTION_AUDIT_DAYS=90

# ---- ffmpeg (timeline, render, thumbnail, audio người dùng đưa; video đầu vào do ag-go chuẩn bị) ----
# Worker và API (image Docker đã đặt /usr/bin/ffmpeg). Không có trên worker: job dựng/render/thumbnail chờ
# một worker có ffmpeg. API cần STUDIO_FFMPEG_PATH để nhận giọng mẫu / nhạc người dùng đưa (không có: 503 audio_disabled;
# chọn bài trong kho nhạc thì không cần).
# STUDIO_FFMPEG_PATH=/usr/bin/ffmpeg
# ffprobe (mặc định: ffprobe cạnh STUDIO_FFMPEG_PATH).
# STUDIO_FFPROBE_PATH=/usr/bin/ffprobe
# Cho link audio trỏ vào mạng nội bộ (chỉ stack local, nơi ag-go ở localhost). Không bao giờ bật trên máy triển khai.
# STUDIO_AUDIO_ALLOW_PRIVATE_URLS=false
# Thư mục có font Arial cho chữ trên thumbnail; mặc định: font Windows, trên Linux fontconfig (Liberation Sans, cài
# trong image).
# STUDIO_FONTS_DIR=

# ---- Crawl YouTube (tab Nghiên cứu, tool của agent) ----
# YouTube Data API v3: hạn mức mặc định 10.000 đơn vị/ngày (search.list 100 đơn vị/trang). Không đặt thì worker tìm
# bằng yt-dlp (không tốn hạn mức, chậm hơn, ít số liệu hơn).
# YOUTUBE_API_KEY=

# ---- yt-dlp (crawl không có API key, video mẫu để học phong cách dựng) ----
# Image Docker đã cài và đặt biến này. Tải video mẫu chỉ khi người dùng bấm xác nhận thẻ `reference_download` (rủi ro
# điều khoản YouTube, ADR mục 175): ≤480p, đo nhịp cắt, trích khung rồi xoá video. STUDIO_REFERENCE_DOWNLOADS=0 tắt hẳn.
# YTDLP_PATH=yt-dlp
# STUDIO_REFERENCE_DOWNLOADS=1

FARM_POLL_MS=5000

# ---- Web (nhúng lúc build) ----
VITE_AG_GO_API_URL=https://go-api.example.com/api
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_studio_web_client_id
VITE_AUTH0_AUDIENCE=https://your-api-audience
